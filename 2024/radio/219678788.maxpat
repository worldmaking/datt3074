														"numoutlets" : 0,
														"patching_rect" : [ 179.0, 224.0, 150.0, 48.0 ],
														"numinlets" : 1
													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "scaled the months to a range suited for bass freqs (didn't want it on the same freq as the melodic steps)",
														"linecount" : 5,
														"id" : "obj-34",
														"numoutlets" : 0,
