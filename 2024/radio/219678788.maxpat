													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "took the direct value of the secs, but inputted it into a sin function and amplified it by 1.5x for a smooth transition for the index value",
														"linecount" : 6,
														"id" : "obj-41",
														"numoutlets" : 0,
														"patching_rect" : [ 475.0, 341.0, 150.0, 89.0 ],
