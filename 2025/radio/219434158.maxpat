													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "Convert beat ramps into trigger signals",
														"linecount" : 2,
														"patching_rect" : [ 256.0, 278.0, 150.0, 33.0 ],
														"id" : "obj-67",
														"numinlets" : 1,
														"numoutlets" : 0
													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "About this patch:\n\nI wanted to design a generative radio station that feels alive something halfway between a digital clock and a distant broadcast always changing, never repeating. The time data drives a series of ramps and triggers that generate repeating yet constantly evolving melodic pulses. Random noise and shift registers decide which tones are played,\nThe sound is intentionally a little mechanical, like a small robot radio trying to find a signal. The hour sets harmonic range, minute and second control modulation speed and rhythmic density, and the month influences long-term variation. Together they make every moment distinct the same patch never sounds the same twice. Balancing regular rhythmic pulses with slow, evolving modulation. There’s always a sense of pulse and motion, but the details keep shifting, making it interesting to tune into for a long time. ",
														"linecount" : 20,
														"patching_rect" : [ 783.200011670589447, 337.600005030632019, 299.0, 275.0 ],
														"id" : "obj-65",
														"numinlets" : 1,
														"numoutlets" : 0
													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "Parameters:\n\nThis patch responds mainly to time-based variation and noise-driven modulation. By changing just the hour, minute, and month parameters, the entire texture, rhythmic motion, and tonal mood of the station shift. The parameters are either a random date and time or the current date and time.\nThe hour parameter scales the oscillator frequency, while the minute controls the modulation rate and filter motion and the month adds a slow variation changing how often the pattern refreshes. This creates a continuously evoling time-reactive radio.",
														"linecount" : 13,
														"patching_rect" : [ 783.200011670589447, 136.0, 299.0, 181.0 ],
														"id" : "obj-63",
														"numinlets" : 1,
														"numoutlets" : 0
													}

												}
, 												{
													"box" : 													{
														"maxclass" : "comment",
														"text" : "How to run patch:\n\nTurn on audio in max by clicking the speaker.\nChoose your time mode:\n   - Click use the current date and time” for real-time mode.\n   - Or pick a random date and time for a randoom.",
														"linecount" : 7,
														"patching_rect" : [ 783.200011670589447, 14.400000214576721, 296.0, 100.0 ],
														"id" : "obj-60",
														"numinlets" : 1,
														"numoutlets" : 0
													}

												}
