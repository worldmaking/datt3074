, 											{
												"box" : 												{
													"code" : "// Gloubi-boulga Overdrive + Asymmetry + Tone\nx = in1 * in2;\n\n// nonlinear shaping factor\na = 1 + exp(sqrt(abs(x)) * -0.75);\n\n// core waveshaper\ndrive = (exp(x) - exp(-x * a)) / (exp(x) + exp(-x));\n\n// add asymmetry (odd/even harmonic balance)\nasym = drive + 0.2 * drive * drive;\n\n// simple tone control (low-pass blend)\ntone = (asym * 0.7) + (asym / (1 + abs(asym) * 5) * 0.3);\n\n// final output\nout1 = tone;",
													"fontface" : 0,
													"fontname" : "<Monospaced>",
													"fontsize" : 12.0,
													"id" : "obj-13",
													"maxclass" : "codebox",
